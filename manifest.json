{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "default_locale": "en",
  "version": "1.2.0",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "24": "icons/icon-24.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://users.roblox.com/*",
    "https://friends.roblox.com/*",
    "https://presence.roblox.com/*",
    "https://accountinformation.roblox.com/*",
    "https://inventory.roblox.com/*",
    "https://badges.roblox.com/*",
    "https://games.roblox.com/*",
    "https://apis.roblox.com/universes/v1/places/*",
    "https://groups.roblox.com/*",
    "https://gamejoin.roblox.com/*",
    "https://ipwho.is/*",
    "https://develop.roblox.com/*",
    "https://api.fxtwitter.com/*",
    "https://pbs.twimg.com/*",
    "https://mosaic.fxtwitter.com/*",
    "https://thumbnails.roblox.com/*",
    "https://www.rolimons.com/*",
    "https://www.youtube.com/*",
    "https://i.ytimg.com/*",
    "https://cdn.jsdelivr.net/*",
    "https://latest.currency-api.pages.dev/*",
    "https://catalog.roblox.com/*",
    "https://economy.roblox.com/*",
    "https://assetdelivery.roblox.com/*",
    "https://contentdelivery.roblox.com/v1/bytes/*",
    "https://avatar.roblox.com/*",
    "https://*.rbxcdn.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker-bundle.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-48.png",
        "icons/icon-128.png",
        "src/settings/assets/qq-group-qr.jpg",
        "UPDATE.md",
        "UPDATE.zh-CN.md",
        "UPDATE.zh-TW.md",
        "UPDATE.id.md",
        "UPDATE.ja.md",
        "UPDATE.th.md",
        "UPDATE.ko.md",
        "src/servers/globe/geo-engine.mjs",
        "src/servers/globe/countries.mjs",
        "src/assets/animation-preview/renderer.html"
      ],
      "matches": [
        "https://www.roblox.com/*",
        "https://roblox.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.roblox.com/*",
        "https://roblox.com/*"
      ],
      "css": ["src/shared/startup.css"],
      "js": [
        "src/shared/routes.js",
        "src/shared/compatibility.js",
        "src/shared/dialogs.js",
        "src/shared/avatar-diagnostics.js",
        "src/shared/startup.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.roblox.com/*",
        "https://roblox.com/*",
        "https://create.roblox.com/*"
      ],
      "js": [
        "src/shared/routes.js",
        "src/shared/compatibility.js",
        "src/shared/runtime.js",
        "src/shared/native-labels.js",
        "src/shared/i18n.js",
        "src/shared/fonts.js",
        "src/currency/robux-currency-core.js",
        "src/currency/robux-currency.js"
      ],
      "css": [
        "src/shared/theme.css",
        "src/shared/fonts.css",
        "src/currency/robux-currency.css"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.roblox.com/*",
        "https://roblox.com/*"
      ],
      "js": [
        "src/shared/page-bridge-bundle.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.roblox.com/*",
        "https://roblox.com/*"
      ],
      "css": [
        "src/home/friends.css",
        "src/home/pinned-friends.css",
        "src/home/friends-manager.css",
        "src/settings/settings.css",
        "src/settings/extension-warning.css",
        "src/settings/settings-guide.css",
        "src/settings/update-announcement.css",
        "src/servers/server-history.css",
        "src/pages/games/game-page.css",
        "src/pages/games/game-store.css",
        "src/pages/games/private-server-configure.css",
        "src/pages/games/item-details-page.css",
        "src/shared/site-pages.css",
        "src/pages/discovery/charts-page.css",
        "src/pages/discovery/search-page.css",
        "src/pages/catalog/catalog-page.css",
        "src/pages/catalog/catalog-item-page.css",
        "src/pages/account/account-pages.css",
        "src/pages/account/account-settings-page.css",
        "src/pages/account/messages-page.css",
        "src/pages/account/transactions-page.css",
        "src/pages/reporting/report-abuse.css",
        "src/pages/robux/robux-page.css",
        "src/pages/community/community-directory.css",
        "src/pages/profile/profile-page.css",
        "src/pages/profile/profile-edit.css",
        "src/pages/avatar/avatar-page.css",
        "src/home/pinned-games.css",
        "src/notes/game-notes.css",
        "src/playtime/playtime.css",
        "src/servers/server-globe.css",
        "src/assets/tools.css",
        "src/assets/animation-bundle.css"
      ],
      "js": [
        "src/shared/routes.js",
        "src/shared/compatibility.js",
        "src/home/friends.js",
        "src/home/pinned-friends-core.js",
        "src/home/pinned-friend-menu.js",
        "src/home/pinned-friends.js",
        "src/home/friends-manager.js",
        "src/home/follower-count.js",
        "src/notes/game-notes-core.js",
        "src/settings/backup-core.js",
        "src/servers/server-history-core.js",
        "src/servers/server-history.js",
        "src/settings/terms-acceptance.js",
        "src/settings/language-warning.js",
        "src/settings/extension-warning.js",
        "src/settings/settings.js",
        "src/settings/settings-guide.js",
        "src/settings/update-announcement-core.js",
        "src/settings/update-announcement.js",
        "src/shared/frosted-ui.js",
        "src/pages/account/account-settings-page.js",
        "src/pages/games/private-server-configure.js",
        "src/pages/profile/profile-page.js",
        "src/pages/avatar/avatar-page.js",
        "src/pages/catalog/catalog-item-page.js",
        "src/home/pinned-games-core.js",
        "src/home/pinned-games.js",
        "src/playtime/playtime-core.js",
        "src/playtime/playtime.js",
        "src/notes/game-notes.js",
        "src/assets/vendor/fzstd-0.1.1.js",
        "src/assets/model-reader.js",
        "src/assets/asset-core.js",
        "src/assets/tools-ui.js",
        "src/assets/model-schema.js",
        "src/assets/resource-explorer.js",
        "src/assets/asset-tools.js",
        "src/assets/avatar-tools.js",
        "src/assets/animation-bundle.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.roblox.com/*",
        "https://roblox.com/*"
      ],
      "js": [
        "src/shared/routes.js",
        "src/shared/compatibility.js",
        "src/servers/server-globe.js",
        "src/pages/games/game-page.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.roblox.com/my/messages*",
        "https://roblox.com/my/messages*",
        "https://www.roblox.com/*/my/messages*",
        "https://roblox.com/*/my/messages*"
      ],
      "js": [
        "src/shared/routes.js",
        "src/shared/compatibility.js",
        "src/pages/account/messages-page.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://create.roblox.com/store/asset/*"
      ],
      "js": [
        "src/assets/vendor/fzstd-0.1.1.js",
        "src/assets/model-reader.js",
        "src/assets/asset-core.js",
        "src/assets/tools-ui.js",
        "src/assets/model-schema.js",
        "src/assets/resource-explorer.js",
        "src/assets/asset-tools.js"
      ],
      "css": [
        "src/assets/tools.css"
      ],
      "run_at": "document_start"
    }
  ]
}
